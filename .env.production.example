# ===========================================================================
# CampusConnect — Production Environment Configuration
# ===========================================================================

ENV=production
DEBUG=false
LOG_LEVEL=INFO
LOG_FORMAT=json

# Domain & Networking
PRODUCTION_DOMAIN=campusconnect.college.edu
CORS_ALLOWED_ORIGINS=["https://campusconnect.college.edu"]

# Database Credentials
POSTGRES_DB=campusconnect
POSTGRES_USER=campusconnect
POSTGRES_PASSWORD=CHANGE_ME_TO_A_STRONG_RANDOM_PASSWORD_32_CHARS
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# Security Secrets (Must be at least 32 random characters in production)
JWT_SECRET_KEY=GENERATE_WITH_openssl_rand_hex_32
REFRESH_TOKEN_SECRET=GENERATE_WITH_openssl_rand_hex_32

# Cookie Security (Enforced true in production)
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
COOKIE_PATH=/api/v1/auth

# Academic & Institutional Policy
ALLOWED_EMAIL_DOMAIN=college.edu
HALL_BOOKING_MIN_ADVANCE_DAYS=7
CURRENT_ACADEMIC_YEAR=2026-27

# Email Provider
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USERNAME=apikey
SMTP_PASSWORD=YOUR_SMTP_API_KEY
SMTP_FROM_EMAIL=noreply@campusconnect.college.edu
SMTP_USE_TLS=true

# Storage
STORAGE_PROVIDER=local
UPLOAD_BASE_DIR=/app/uploads
