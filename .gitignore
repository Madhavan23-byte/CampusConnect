# CampusConnect .gitignore

# Environment variables — NEVER commit
.env
.env.local
.env.*.local

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.venv/
venv/
env/
.mypy_cache/
.ruff_cache/
.pytest_cache/
htmlcov/
.coverage
coverage.xml

# Node.js
node_modules/
npm-debug.log*
dist/
*.local

# Uploads (never commit uploaded files)
backend/uploads/
uploads/

# Docker
.docker/

# IDE
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Database dumps (contain sensitive data)
*.sql.gz
*.dump
