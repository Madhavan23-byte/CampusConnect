# ============================================================
# CampusConnect — Environment Variables
# ============================================================
# Copy this file to .env and fill in real values.
# NEVER commit the real .env file to version control.
# See README.md for setup instructions.
# ============================================================

# Application
ENV=development
DEBUG=false
LOG_LEVEL=INFO

# PostgreSQL
POSTGRES_DB=campusconnect
POSTGRES_USER=campusconnect
POSTGRES_PASSWORD=CHANGE_THIS_TO_A_STRONG_PASSWORD
POSTGRES_PORT=5432

# JWT Secrets — MUST be changed before any production use
# Generate with: python -c "import secrets; print(secrets.token_hex(64))"
JWT_SECRET_KEY=CHANGE_ME_GENERATE_WITH_SECRETS_TOKEN_HEX_64

# Email Domain — change to actual college domain (e.g. college.edu)
ALLOWED_EMAIL_DOMAIN=college.edu

# Email Provider
# development: logs tokens to console (no SMTP needed)
# smtp: sends real emails (fill SMTP_* vars below)
EMAIL_PROVIDER=development
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@campusconnect.local

# File Storage
UPLOAD_BASE_DIR=/app/uploads

# Frontend (dev server)
VITE_API_BASE_URL=http://localhost:8000

# CORS Allowed Origins — JSON array of allowed origin URLs
CORS_ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Port overrides (optional)
BACKEND_PORT=8000
FRONTEND_PORT=5173

# Business Rules (configurable without code changes)
HALL_BOOKING_MIN_ADVANCE_DAYS=7
CURRENT_ACADEMIC_YEAR=2026-27
